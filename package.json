{
  "name": "dai-core",
  "version": "0.1.0",
  "description": "Vite plugin that compiles a built React/Vite app into a single air-gapped .dai.html polyglot container.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicapplicationinterface/dai-core.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicapplicationinterface/dai-core/issues"
  },
  "homepage": "https://github.com/dynamicapplicationinterface/dai-core#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "require": "./dist/templates.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:runner": "vite build apps/runner",
    "build:studio": "vite build examples/web-studio",
    "build:desktop": "vite build apps/desktop",
    "build:all": "tsup && node scripts/build-demo-cartridge.js && vite build apps/runner && vite build examples/web-studio && vite build apps/desktop",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json",
    "prepublishOnly": "npm run build",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "keywords": [
    "vite-plugin",
    "dai",
    "offline",
    "air-gapped",
    "polyglot"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@types/node": "^22.20.1",
    "esbuild-wasm": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
