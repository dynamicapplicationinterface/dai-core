{
  "name": "dai-core",
  "version": "0.1.0",
  "description": "Compile a web app into a single air-gapped .dai.html file that holds its own SQLite database, runs from a double-click with nothing installed, and is tamper-evident. Command line, MCP server and Vite plugin.",
  "keywords": [
    "dai",
    "container",
    "offline",
    "air-gapped",
    "single-file",
    "sqlite",
    "wasm",
    "cli",
    "mcp",
    "vite-plugin",
    "portable",
    "tamper-evident"
  ],
  "homepage": "https://github.com/dynamicapplicationinterface/dai-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicapplicationinterface/dai-core.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicapplicationinterface/dai-core/issues"
  },
  "license": "MIT",
  "author": "Dynamic Application Interface",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "dai": "dist/bin.js",
    "dai-mcp": "dist/mcp-bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js",
      "require": "./dist/templates.cjs"
    },
    "./container": {
      "types": "./dist/container.d.ts",
      "import": "./dist/container.js",
      "require": "./dist/container.cjs"
    },
    "./compile": {
      "import": {
        "types": "./dist/compile.d.ts",
        "default": "./dist/compile.js"
      },
      "require": {
        "types": "./dist/compile.d.cts",
        "default": "./dist/compile.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "build:runner": "vite build apps/runner",
    "build:studio": "vite build examples/web-studio",
    "build:desktop": "vite build apps/desktop",
    "build:all": "tsup && node scripts/build-demo-cartridge.js && vite build apps/runner && vite build examples/web-studio && vite build apps/desktop",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json",
    "prepublishOnly": "npm run build",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "cbor-x": "^1.6.6",
    "esbuild-wasm": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  }
}
