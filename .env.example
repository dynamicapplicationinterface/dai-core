# Credentials for publishing to a store. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#
# .env.local is ignored by git and must stay that way. These values are a write
# credential for a bucket: they belong on the machine doing the publishing and
# nowhere else.
#
# Nothing deployed needs them. The opener fetches blobs over plain HTTPS from a
# public URL, and the edge middleware reads sidecars the same way — a preview is
# built from a public object. If one of these ever has to be set on Vercel, in a
# browser bundle, or inside a container, something has been designed wrong.

# --- A directory, for a local test or a machine that serves its own files -----
# DAI_STORE_DIR=./store
# The URL that directory appears under. Without it, links name a file: URL that
# only this machine can follow — right for a test, useless to send.
# DAI_STORE_BASE=https://store.example/

# --- S3-compatible, which is how R2 is spoken to ------------------------------
# Set all five or none. A part-configured store refuses to publish rather than
# quietly writing somewhere else.
# DAI_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# DAI_S3_BUCKET=dai-store
# DAI_S3_REGION=auto
# DAI_S3_ACCESS_KEY_ID=
# DAI_S3_SECRET_ACCESS_KEY=
# Where the public reads the bucket: the custom domain, not the endpoint.
# DAI_S3_PUBLIC_BASE=https://store.opendai.app/

# Accept documents stored without encryption. Off unless this is a store you
# run inside a perimeter that already controls who reaches it — with it on, the
# store can read every document it holds, and so can anything between.
# DAI_S3_ALLOW_CLEAR=0

# --- The MCP server -----------------------------------------------------------
# Where links point.
# DAI_OPENER=https://opendai.app
# Turn link previews off by default for every app this server builds.
# DAI_PREVIEW_DEFAULT=off
