node_modules/
dist/
*.dai
*.dai.html
# The documentation site ships sample cartridges as deliberate distribution
# assets, so they are tracked. Without these the patterns above would silently
# untrack them and the site would build without its samples.
!website/public/*.dai
!website/public/*.dai.html
*.bat
test-results/
playwright-report/
tests/fixture/dist/
tests/fixture/*.pem
examples/web-studio/dist/
apps/runner/dist/
apps/desktop/dist/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# Staged by apps/desktop/scripts/stage-runtime.mjs
apps/desktop/public/runtime/

# The conformance suite is committed on purpose. Its cases are built containers,
# which the rules above would otherwise sweep out — and a suite that cannot be
# checked out is not a suite anybody else can run against.
!conformance/cases/*.dai
!conformance/cases/*.dai.html
!conformance/cases/*.html

# A signing key is never committed. The one exception is conformance/signing-key.pem,
# which signs documents that exist only to be checked, and says so in its README.
/*.pem

# Rust build output. 461 files of it were committed once, 375 carrying a local
# home-directory path; nothing in target/ is source.
crates/*/target/
