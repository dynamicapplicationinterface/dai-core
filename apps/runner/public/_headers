/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Named by content: what a host used to rebuild links from never changes.
/hosts/index.json
  Cache-Control: no-cache

/hosts/*
  Cache-Control: public, max-age=31536000, immutable

# The build stamp answers "which deploy is this". A cached one answers with
# the deploy before, which is the question it exists to end.
/version.json
  Cache-Control: no-cache
